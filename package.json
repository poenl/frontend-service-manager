{
  "name": "frontend-service-manager",
  "version": "0.1.0",
  "description": "Manage Vite dev servers from a web UI — spawn, watch logs, pause/resume, all in one local dashboard.",
  "keywords": [
    "frontend",
    "service",
    "manager",
    "vite",
    "dev-server",
    "dashboard",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/poenl/frontend-service-manager.git"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "fsm": "scripts/manage.mjs"
  },
  "files": [
    ".next/standalone",
    "scripts"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache",
    "typecheck": "tsc --noEmit",
    "check": "concurrently -n ts,lint -c cyan,green \"pnpm typecheck\" \"pnpm lint\"",
    "prepack": "pnpm build && node scripts/manage.mjs stage"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "anser": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "conf": "^15.1.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
